# 复制为 /opt/paper-analyzer/.env 后按需修改
# ---------------------------------------------

# 数据库配置（仅 Docker 内网访问，不暴露公网端口）
POSTGRES_DB=paper_analyzer
POSTGRES_USER=paper_admin
POSTGRES_PASSWORD=change_me_to_a_strong_password

# 镜像坐标与标签（与 GitHub Actions 推送的 GHCR 路径一致，全小写）
IMAGE_PREFIX=ghcr.io/artechphy/academic-paper-analysis-system
IMAGE_TAG=latest

# 对外端口与后端并发度（2C4G 建议 2；2C2G 演示机建议改为 1）
HTTP_PORT=80
UVICORN_WORKERS=2

# 同源部署时保持默认值即可；如需额外跨域地址请保持 JSON 数组格式
CORS_ORIGINS=["http://localhost"]

# DeepSeek LLM 可选配置（留空则自动降级为确定性规则修复）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=25.0
